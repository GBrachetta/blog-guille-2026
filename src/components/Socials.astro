---
import config from "@/config";
import LinkButton from "./LinkButton.astro";

const { site, socials } = config;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const items = await Promise.all(
  socials.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const title =
      linkTitle ??
      (url.startsWith("mailto:") || name === "mail"
        ? `Send an email to ${site.title}`
        : `${site.title} on ${name.charAt(0).toUpperCase() + name.slice(1)}`);
    return { url, title, Icon };
  })
);

const locale = Astro.currentLocale ?? "en";
const targetLocale = locale === "en" ? "es" : "en";
const label = targetLocale === "es" ? "Español" : "English";

const postSlugsEnToEs: Record<string, string> = {
  "mozarts-dice-game": "el-juego-de-dados-de-mozart",
  "six-hours-to-save-three-seconds":
    "como-le-ensene-a-mi-cama-a-cegarme-a-las-3-am",
  "my-home-assistant-setup-part-1": "mi-setup-de-home-assistant-parte-1",
  "building-websites-for-musicians":
    "por-que-los-sitios-web-de-musicos-siguen-pareciendo-de-2004",
  "why-a-harpsichord-is-never-in-tune":
    "por-que-un-clave-nunca-puede-estar-afinado",
  "my-home-assistant-setup-part-2": "mi-setup-de-home-assistant-parte-2",
  "the-good-night-protocol": "el-protocolo-de-buenas-noches",
  "automations-that-babysit-other-automations":
    "automatizaciones-que-cuidan-a-otras-automatizaciones",
  "historical-treatises-musicians-arguing-in-print":
    "tratados-historicos-musicos-discutiendo-por-escrito",
  "basso-continuo-live-coding-in-1680": "basso-continuo-live-coding-en-1680",
  "why-i-built-this-blog-with-astro": "por-que-construi-este-blog-con-astro",
};

const postSlugsEsToEn: Record<string, string> = Object.fromEntries(
  Object.entries(postSlugsEnToEs).map(([en, es]) => [es, en])
);

const tagSlugsEnToEs: Record<string, string> = {
  devices: "dispositivos",
  "early-music": "musica-barroca",
  "smart-home": "domotica",
  tuning: "afinacion",
  "web-development": "desarrollo-web",
  harpsichord: "clave",
  automations: "automatizaciones",
  sensors: "sensores",
  history: "historia",
  musicology: "musicologia",
};

const tagSlugsEsToEn: Record<string, string> = Object.fromEntries(
  Object.entries(tagSlugsEnToEs).map(([en, es]) => [es, en])
);

const pathname = Astro.url.pathname.replace(/\/+$/, "");
let switchUrl = targetLocale === "es" ? "/es/" : "/";

if (locale === "en") {
  if (pathname === "" || pathname === "/") {
    switchUrl = "/es/";
  } else if (pathname === "/about") {
    switchUrl = "/es/about/";
  } else if (pathname === "/privacy") {
    switchUrl = "/es/privacy/";
  } else if (pathname === "/archives") {
    switchUrl = "/es/archives/";
  } else if (pathname === "/search") {
    switchUrl = "/es/search/";
  } else if (pathname === "/posts") {
    switchUrl = "/es/posts/";
  } else if (pathname.startsWith("/posts/")) {
    const postSlug = pathname.replace(/^\/posts\//, "");
    const mapped = postSlugsEnToEs[postSlug];
    switchUrl = mapped ? `/es/posts/${mapped}/` : "/es/posts/";
  } else if (pathname === "/tags") {
    switchUrl = "/es/tags/";
  } else if (pathname.startsWith("/tags/")) {
    const tagSlug = pathname.replace(/^\/tags\//, "");
    const mapped = tagSlugsEnToEs[tagSlug] ?? tagSlug;
    switchUrl = `/es/tags/${mapped}/`;
  } else {
    switchUrl = "/es/";
  }
} else {
  // Current locale is Spanish
  const stripped = pathname.replace(/^\/es/, "");
  if (stripped === "" || stripped === "/") {
    switchUrl = "/";
  } else if (stripped === "/about") {
    switchUrl = "/about/";
  } else if (stripped === "/privacy") {
    switchUrl = "/privacy/";
  } else if (stripped === "/archives") {
    switchUrl = "/archives/";
  } else if (stripped === "/search") {
    switchUrl = "/search/";
  } else if (stripped === "/posts") {
    switchUrl = "/posts/";
  } else if (stripped.startsWith("/posts/")) {
    const postSlug = stripped.replace(/^\/posts\//, "");
    const mapped = postSlugsEsToEn[postSlug];
    switchUrl = mapped ? `/posts/${mapped}/` : "/posts/";
  } else if (stripped === "/tags") {
    switchUrl = "/tags/";
  } else if (stripped.startsWith("/tags/")) {
    const tagSlug = stripped.replace(/^\/tags\//, "");
    const mapped = tagSlugsEsToEn[tagSlug] ?? tagSlug;
    switchUrl = `/tags/${mapped}/`;
  } else {
    switchUrl = "/";
  }
}
---

<div class="flex flex-wrap items-center gap-1">
  {
    items.map(({ url, title, Icon }) =>
      Icon ? (
        <LinkButton href={url} class="p-2 hover:rotate-6 sm:p-1" title={title}>
          <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
          <span class="sr-only">{title}</span>
        </LinkButton>
      ) : null
    )
  }
  <span class="text-border mx-1 select-none" aria-hidden="true">|</span>
  <a
    href={switchUrl}
    class="focus-outline border-border bg-muted/50 text-foreground hover:border-accent hover:bg-accent hover:text-accent-foreground inline-flex items-center rounded border px-2.5 py-0.5 text-xs font-medium transition-all"
    title={targetLocale === "es" ? "Cambiar a Español" : "Switch to English"}
    aria-label={targetLocale === "es"
      ? "Cambiar a Español"
      : "Switch to English"}
  >
    {label}
  </a>
</div>
