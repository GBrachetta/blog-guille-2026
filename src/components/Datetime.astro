---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import IconClock from "@/assets/icons/IconClock.svg";
import config from "@/config";
import { tplStr, useTranslations } from "@/i18n";
import { resolveTimezone } from "@/utils/resolveTimezone";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  readingTime?: number | string;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  readingTime,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const isModified = modDatetime && modDatetime > pubDatetime;

const datetime = dayjs(isModified ? modDatetime : pubDatetime).tz(
  resolveTimezone(postTimezone ?? config.site.timezone)
);

const date = datetime.format("D MMM, YYYY");
---

<div
  class:list={[
    "text-muted-foreground flex flex-wrap items-center gap-x-2 gap-y-1",
    className,
  ]}
>
  <div class="flex items-center gap-x-2">
    <IconCalendar
      class:list={[
        "inline-block size-6 min-w-5.5",
        { "scale-90": size === "sm" },
      ]}
    />
    {
      isModified && (
        <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
          {t.post.updatedAt}:
        </span>
      )
    }
    <time
      class:list={["text-sm", { "sm:text-base": size === "lg" }]}
      datetime={datetime.toISOString()}
    >
      {date}
    </time>
  </div>
  {
    readingTime && (
      <>
        <span
          aria-hidden="true"
          class:list={[
            "text-muted-foreground/60 select-none",
            { "text-sm": size === "sm", "text-base": size === "lg" },
          ]}
        >
          ·
        </span>
        <div class="flex items-center gap-x-1.5">
          <IconClock
            class:list={[
              "inline-block size-6 min-w-5.5",
              { "scale-90": size === "sm" },
            ]}
          />
          <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
            {typeof readingTime === "number"
              ? tplStr(t.post.readingTime, { minutes: readingTime })
              : readingTime}
          </span>
        </div>
      </>
    )
  }
</div>
